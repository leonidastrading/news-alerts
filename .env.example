# --- Worker (Railway) ---
# Alpaca PAPER account API keys (Alpaca dashboard → Paper Trading → API Keys).
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Neon connection string (same value as the Vercel project's DATABASE_URL).
DATABASE_URL=
# Resend API key; ALERT_EMAIL must be the address your Resend account was created with.
RESEND_API_KEY=
ALERT_EMAIL=
# Link at the bottom of each email.
DASHBOARD_URL=https://news-alerts-vadim54-9159s-projects.vercel.app

# --- Optional tuning (defaults shown) ---
# MOVE_PCT=1.5               alert at this % move from the price when the headline arrived
# CONFIRM_TICKS=2            consecutive price checks that must agree
# WATCH_MINUTES=30           how long to watch a stock after a headline
# POLL_SECONDS=5             seconds between price checks
# MAX_SYMBOLS_PER_HEADLINE=4 skip roundups tagged with more tickers
# MIN_PRICE=3
# MIN_IEX_DOLLAR_VOLUME=500000
# COOLDOWN_MINUTES=120       don't alert the same stock again within this
# OPEN_RANGE_MINUTES=5       pre-open news: opening range length after the open
# OPEN_WATCH_MINUTES=60      pre-open news: watch for a range break until this many minutes after the open
# BREAKOUT_BUFFER_PCT=0.1    a break must clear the range by this %
# MISS_MOVE_PCT=5            missed moves: record stocks up/down this % on the day with no alert
# PAPER_TRADING=on           set to off to only alert
# TRADE_NOTIONAL=2000        dollars per paper trade
# HOLD_MINUTES=0             0 = hold each paper trade to the end of the day; otherwise close after this many minutes
