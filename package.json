{
  "name": "news-alerts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Watches market news, alerts by email when a stock in the news moves, paper-trades the alert and records how it turned out",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm run worker",
    "start:web": "next start",
    "worker": "node --experimental-strip-types --disable-warning=ExperimentalWarning worker/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test lib/*.test.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
